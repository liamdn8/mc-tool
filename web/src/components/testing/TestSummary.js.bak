import React from 'react';
import { CheckCircle2, XCircle, Clock, Upload, AlertCircle, Loader } from 'lucide-react';

const formatDuration = (ms) => {
    if (!ms) return '0s';
    const seconds = Math.floor(ms / 1000000000); // ns to seconds
    if (seconds < 60) return `${seconds}s`;
    const minutes = Math.floor(seconds / 60);
    const secs = seconds % 60;
    return `${minutes}m ${secs}s`;
};

const formatBytes = (bytes) => {
    if (bytes < 1024) return `${bytes} B`;
    if (bytes < 1024 * 1024) return `${(bytes / 1024).toFixed(2)} KB`;
    if (bytes < 1024 * 1024 * 1024) return `${(bytes / (1024 * 1024)).toFixed(2)} MB`;
    return `${(bytes / (1024 * 1024 * 1024)).toFixed(2)} GB`;
};

const TestProgress = ({ status }) => {
    if (!status) {
        console.log('TestProgress: No status provided');
        return null;
    }

    console.log('TestProgress render:', {
        currentRound: status.currentRound,
        totalRounds: status.totalRounds,
        roundDetailsCount: status.roundDetails?.length || 0,
        progress: status.progress
    });

    const { 
        running, 
        progress, 
        currentPhase,
        completedUploads,
        totalUploads,
        successfulUploads,
        failedUploads,
        currentRound,
        totalRounds,
        elapsedTime,
        roundDetails,
        recentUploads
    } = status;

    return (
        <div className="space-y-4">
            {/* Test Summary - Always on top, updates in real-time */}
            <div className="bg-white border border-gray-300 rounded-lg p-4">
                <h3 className="text-lg font-semibold text-gray-900 mb-4">Test Summary</h3>
                
                <div className="stats-grid" style={{ marginBottom: 0 }}>
                    <div className="stat-card">
                        <div className="stat-value" style={{ color: 'var(--primary-color)' }}>
                            {totalUploads || 0}
                        </div>
                        <div className="stat-label">Total Uploads</div>
                    </div>
                    
                    <div className="stat-card">
                        <div className="stat-value" style={{ color: 'var(--success-color)' }}>
                            {successfulUploads || 0}
                        </div>
                        <div className="stat-label">Successful</div>
                    </div>
                    
                    <div className="stat-card">
                        <div className="stat-value" style={{ color: 'var(--danger-color)' }}>
                            {failedUploads || 0}
                        </div>
                        <div className="stat-label">Failed</div>
                    </div>
                    
                    <div className="stat-card">
                        <div className="stat-value" style={{ color: 'var(--primary-color)' }}>
                            {formatDuration(elapsedTime)}
                        </div>
                        <div className="stat-label">Total Duration</div>
                    </div>
                    
                    <div className="stat-card">
                        <div className="stat-value" style={{ color: 'var(--primary-color)' }}>
                            {formatBytes((successfulUploads || 0) * 1024)}
                        </div>
                        <div className="stat-label">Data Uploaded</div>
                    </div>
                </div>
            </div>

            {/* Overall Progress */}
            <div className="bg-white border border-gray-300 rounded-lg p-4">
                <h3 className="text-lg font-semibold text-gray-900 mb-3">Upload Progress</h3>
                
                <div className="space-y-3">
                    {/* Progress Bar */}
                    <div>
                        <div className="flex justify-between text-sm text-gray-600 mb-1">
                            <span>Overall Progress</span>
                            <span>{progress}%</span>
                        </div>
                        <div className="w-full bg-gray-200 rounded-full h-2">
                            <div 
                                className="bg-blue-600 h-2 rounded-full transition-all duration-300"
                                style={{ width: `${progress}%` }}
                            />
                        </div>
                    </div>

                    {/* Stats Grid */}
                    <div className="grid grid-cols-2 md:grid-cols-4 gap-3 mt-4">
                        <div className="bg-blue-50 border border-blue-200 rounded-md p-3">
                            <div className="text-xs text-blue-600 mb-1">Completed</div>
                            <div className="text-xl font-bold text-blue-900">
                                {completedUploads} / {totalUploads}
                            </div>
                        </div>
                        <div className="bg-green-50 border border-green-200 rounded-md p-3">
                            <div className="text-xs text-green-600 mb-1">Successful</div>
                            <div className="text-xl font-bold text-green-900">{successfulUploads}</div>
                        </div>
                        <div className="bg-red-50 border border-red-200 rounded-md p-3">
                            <div className="text-xs text-red-600 mb-1">Failed</div>
                            <div className="text-xl font-bold text-red-900">{failedUploads}</div>
                        </div>
                        <div className="bg-purple-50 border border-purple-200 rounded-md p-3">
                            <div className="text-xs text-purple-600 mb-1">Elapsed Time</div>
                            <div className="text-xl font-bold text-purple-900">
                                {formatDuration(elapsedTime)}
                            </div>
                        </div>
                    </div>

                    {/* Current Round Info */}
                    {totalRounds > 1 && (
                        <div className="mt-3 p-3 bg-gray-50 border border-gray-200 rounded-md">
                            <div className="text-sm text-gray-700">
                                <span className="font-semibold">Current Round:</span> {currentRound} / {totalRounds}
                            </div>
                        </div>
                    )}

                    {/* Current Phase */}
                    <div className="flex items-center space-x-2 text-sm text-gray-600">
                        {running && (
                            <>
                                <div className="animate-spin h-4 w-4 border-2 border-blue-600 border-t-transparent rounded-full"></div>
                                <span className="capitalize">{currentPhase || 'Processing'}...</span>
                            </>
                        )}
                        {!running && progress === 100 && (
                            <span className="text-green-600 font-semibold">✓ Completed</span>
                        )}
                    </div>
                </div>
            </div>

            {/* Round Details - Table Format (for interval mode) */}
            {totalRounds > 1 && (
                <div className="bg-white border border-gray-300 rounded-lg p-4">
                    <h3 className="text-lg font-semibold text-gray-900 mb-4">Round-by-Round Status</h3>
                    
                    <div style={{ overflowX: 'auto' }}>
                        <table style={{ 
                            width: '100%', 
                            borderCollapse: 'separate',
                            borderSpacing: 0
                        }}>
                            <thead>
                                <tr style={{ 
                                    backgroundColor: 'rgb(249, 250, 251)',
                                    borderBottom: '2px solid rgb(229, 231, 235)'
                                }}>
                                    <th style={{ 
                                        padding: '12px 16px', 
                                        textAlign: 'left',
                                        fontWeight: 600,
                                        fontSize: '14px',
                                        color: 'rgb(55, 65, 81)',
                                        width: '120px'
                                    }}>
                                        Round
                                    </th>
                                    <th style={{ 
                                        padding: '12px 16px', 
                                        textAlign: 'left',
                                        fontWeight: 600,
                                        fontSize: '14px',
                                        color: 'rgb(55, 65, 81)'
                                    }}>
                                        Status
                                    </th>
                                    <th style={{ 
                                        padding: '12px 16px', 
                                        textAlign: 'right',
                                        fontWeight: 600,
                                        fontSize: '14px',
                                        color: 'rgb(55, 65, 81)',
                                        width: '140px'
                                    }}>
                                        Duration
                                    </th>
                                </tr>
                            </thead>
                            <tbody>
                                {Array.from({ length: totalRounds }, (_, idx) => {
                                    const roundNum = idx + 1;
                                    const roundDetail = roundDetails?.find(r => r.round === roundNum);
                                    const isComplete = !!roundDetail && roundDetail.duration > 0;
                                    const isRunning = currentRound === roundNum && !isComplete;
                                    const isPending = roundNum > currentRound;
                                    const hasFailed = roundDetail && roundDetail.failedUploads > 0;
                                    
                                    // Debug log for first render and when state changes
                                    if (idx === 0) {
                                        console.log(`Table render - Round ${roundNum}:`, {
                                            isPending,
                                            isRunning,
                                            isComplete,
                                            currentRound,
                                            roundDetail
                                        });
                                    }
                                    
                                    return (
                                        <tr 
                                            key={roundNum}
                                            style={{ 
                                                borderBottom: '1px solid rgb(229, 231, 235)',
                                                backgroundColor: isRunning ? 'rgb(239, 246, 255)' : 'white',
                                                transition: 'background-color 0.3s ease'
                                            }}
                                        >
                                            {/* Round column */}
                                            <td style={{ 
                                                padding: '12px 16px',
                                                fontWeight: 500,
                                                fontSize: '14px',
                                                color: 'rgb(55, 65, 81)'
                                            }}>
                                                <div className="flex items-center gap-2">
                                                    {isComplete && !hasFailed && <CheckCircle2 size={16} className="text-green-600" />}
                                                    {isComplete && hasFailed && <XCircle size={16} className="text-red-600" />}
                                                    {isRunning && <Loader size={16} className="text-blue-600 spin" />}
                                                    {isPending && <Clock size={16} className="text-gray-400" />}
                                                    <span>Round {roundNum}</span>
                                                </div>
                                            </td>
                                            
                                            {/* Status tags column */}
                                            <td style={{ padding: '12px 16px' }}>
                                                {isPending && (
                                                    <span className="badge" style={{ 
                                                        display: 'inline-flex',
                                                        alignItems: 'center',
                                                        padding: '4px 12px',
                                                        backgroundColor: 'var(--bg-secondary)',
                                                        color: 'var(--text-muted)',
                                                        border: '1px solid var(--border-color)',
                                                        borderRadius: '4px',
                                                        fontSize: '13px',
                                                        fontWeight: 500
                                                    }}>
                                                        <Clock size={14} style={{ marginRight: '4px', display: 'inline-block', verticalAlign: 'middle' }} />
                                                        Pending
                                                    </span>
                                                )}
                                                
                                                {isRunning && (
                                                    <span className="badge" style={{ 
                                                        display: 'inline-flex',
                                                        alignItems: 'center',
                                                        padding: '4px 12px',
                                                        backgroundColor: '#dbeafe',
                                                        color: '#1e40af',
                                                        border: '1px solid #93c5fd',
                                                        borderRadius: '4px',
                                                        fontSize: '13px',
                                                        fontWeight: 500
                                                    }}>
                                                        <Loader size={14} className="spin" style={{ marginRight: '4px', display: 'inline-block', verticalAlign: 'middle' }} />
                                                        Running...
                                                    </span>
                                                )}
                                                
                                                {isComplete && (
                                                    <div style={{ display: 'flex', flexWrap: 'wrap', gap: '6px', alignItems: 'center' }}>
                                                        <span className="badge" style={{ 
                                                            display: 'inline-flex',
                                                            alignItems: 'center',
                                                            padding: '4px 12px',
                                                            backgroundColor: '#dbeafe',
                                                            color: '#1e40af',
                                                            border: '1px solid #93c5fd',
                                                            borderRadius: '4px',
                                                            fontSize: '13px',
                                                            fontWeight: 500
                                                        }}>
                                                            <Upload size={14} style={{ marginRight: '4px', display: 'inline-block', verticalAlign: 'middle' }} />
                                                            {roundDetail.objectsUploaded}
                                                        </span>
                                                        
                                                        <span className="badge badge-success" style={{ 
                                                            display: 'inline-flex',
                                                            alignItems: 'center',
                                                            padding: '4px 12px',
                                                            borderRadius: '4px',
                                                            fontSize: '13px',
                                                            fontWeight: 500
                                                        }}>
                                                            <CheckCircle2 size={14} style={{ marginRight: '4px', display: 'inline-block', verticalAlign: 'middle' }} />
                                                            {roundDetail.successfulUploads}
                                                        </span>
                                                        
                                                        {roundDetail.failedUploads > 0 && (
                                                            <span className="badge badge-danger" style={{ 
                                                                display: 'inline-flex',
                                                                alignItems: 'center',
                                                                padding: '4px 12px',
                                                                borderRadius: '4px',
                                                                fontSize: '13px',
                                                                fontWeight: 500
                                                            }}>
                                                                <XCircle size={14} style={{ marginRight: '4px', display: 'inline-block', verticalAlign: 'middle' }} />
                                                                {roundDetail.failedUploads}
                                                            </span>
                                                        )}
                                                    </div>
                                                )}
                                            </td>
                                            
                                            {/* Duration column */}
                                            <td style={{ 
                                                padding: '12px 16px',
                                                textAlign: 'right',
                                                fontSize: '14px',
                                                color: 'rgb(107, 114, 128)'
                                            }}>
                                                {isComplete ? formatDuration(roundDetail.duration) : '-'}
                                            </td>
                                        </tr>
                                    );
                                })}
                            </tbody>
                        </table>
                    </div>
                </div>
            )}


        </div>
    );
};

export default TestProgress;
